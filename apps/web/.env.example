# VERITAS Oracle web env — Vite requires the VITE_ prefix to expose a var
# to the browser. Copy this file to apps/web/.env.local and fill in.

# Backend API base. Local dev = the FastAPI server you started in apps/api.
# In Vercel, set this to the deployed Railway/Fly URL.
VITE_API_URL=http://localhost:8000

# Mapbox public token (sk.* or pk.*). The fire-detection card renders a
# satellite tile via the Static API. If unset, the card shows a dark
# placeholder with the coordinates printed instead — no error.
VITE_MAPBOX_TOKEN=
